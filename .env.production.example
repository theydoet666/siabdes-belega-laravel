APP_NAME="SIABDES Belega"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siabdes.belega.desa.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Kredensial Administrator Awal (Kosongkan jika ingin random auto-generate pada artisan migrate --seed)
ADMIN_INITIAL_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siabdes_belega
DB_USERNAME=siabdes_user
DB_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuat123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=siabdes_cache

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@belega.desa.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
